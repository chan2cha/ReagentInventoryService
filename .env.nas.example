# 이 파일을 .env.nas로 복사한 뒤 실제 값으로 변경한다.
# .env.nas는 Git과 Docker 빌드 컨텍스트에서 모두 제외된다.

# PostgreSQL 초기 DB와 계정
POSTGRES_USER=reagent_app
POSTGRES_PASSWORD=CHANGE_TO_LONG_RANDOM_ALPHANUMERIC_PASSWORD
POSTGRES_DB=reagent_inventory

# Docker Desktop 로컬 테스트에서는 기본 상대 경로를 사용한다.
# NAS에서는 필요할 때 /volume1/... 형태의 절대 경로로 변경할 수 있다.
POSTGRES_DATA_PATH=./data/postgres
POSTGRES_BACKUP_PATH=./backups

# PostgreSQL 최초 초기화가 느린 NAS에서 사용할 마이그레이션 재시도 설정
MIGRATION_MAX_ATTEMPTS=10
MIGRATION_RETRY_SECONDS=3

# 애플리케이션
APP_PORT=31000
APP_ENV=nas-test
AUTH_URL=http://localhost:31000
AUTH_SECRET=CHANGE_TO_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
