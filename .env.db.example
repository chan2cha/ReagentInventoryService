# Supabase -> self-hosted PostgreSQL 복제 전용 설정 예시
# 이 파일을 .env.supabase-migration으로 복사한 뒤 실제 값을 입력한다.
# 애플리케이션 실행용 .env.nas와 분리해 원본 DB 비밀번호가 앱 컨테이너에 전달되지 않게 한다.

# Supabase Dashboard > Connect > Session pooler의 값을 사용한다.
# Transaction pooler 포트 6543은 pg_dump에 사용하지 않는다.
SOURCE_DB_HOST=aws-0-REGION.pooler.supabase.com
SOURCE_DB_PORT=5432
SOURCE_DB_USER=postgres.PROJECT_REF
SOURCE_DB_PASSWORD=
SOURCE_DB_NAME=postgres
SOURCE_DB_SCHEMA=public

# backups 폴더에 생성할 custom-format 덤프 파일명
SOURCE_DUMP_FILE=supabase-public.dump

# 현재 Docker PostgreSQL 안에 새로 만들 복원 검증용 DB
# 기존 reagent_inventory DB를 직접 덮어쓰지 않는다.
TARGET_DB_NAME=reagent_inventory_import_test

# 대상 PostgreSQL 서비스 정보
# Docker Compose 내부에서는 db:5432로 접근한다.
TARGET_DB_HOST=db
TARGET_DB_PORT=5432
TARGET_DB_USER=reagent_app
TARGET_DB_PASSWORD=

