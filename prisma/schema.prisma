generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  ORDER_MANAGER
  SHIPMENT_MANAGER
  VIEWER
}

enum OrderStatus {
  RECEIVED
  READY_TO_SHIP
  SHIPPED
  CANCELLED
}

enum OrderOrigin {
  MANUAL
  SHORTAGE_REORDER
}

enum ShipmentStatus {
  SHIPPED
  CANCELLED
}

enum ShipmentFulfillmentStatus {
  NORMAL
  PARTIAL
}

enum ShipmentPurpose {
  ORDER
  REPLACEMENT
}

enum ReplacementStatus {
  CONFIRMED
  COMPLETED
  EXCLUDED
}

enum ReturnDisposition {
  COLLECTED_DISPOSED
  CLIENT_DISPOSED
  NOT_COLLECTED
}

enum StockMovementType {
  IN
  OUT
  ADJUST
  DISPOSE
  REVERSE
  TRANSFER
}

enum Warehouse {
  FINISHED_GOODS
  SAMPLE
  RETURNED
  NONCONFORMING
  DISPOSAL
}

model User {
  id                    String          @id @default(cuid())
  loginId               String          @unique
  email                 String?         @unique
  name                  String
  passwordHash          String
  sessionVersion        Int             @default(1)
  mustChangePassword    Boolean         @default(false)
  role                  UserRole        @default(VIEWER)
  isActive              Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  orders                Order[]         @relation("OrderCreatedBy")
  shipments             Shipment[]      @relation("ShipmentShippedBy")
  stockMovements        StockMovement[]
  auditLogs             AuditLog[]
  replacementsCreated   Replacement[]   @relation("ReplacementCreatedBy")
  replacementsCompleted Replacement[]   @relation("ReplacementCompletedBy")
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String?
  description String
  actorId     String
  createdAt   DateTime @default(now())
  actor       User     @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}

model Allergen {
  id         String       @id @default(cuid())
  code       String       @unique
  name       String
  category   String?
  minStock   Int          @default(0)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  lots       ReagentLot[]
  orderItems OrderItem[]

  @@index([name])
}

model ReagentLot {
  id              String           @id @default(cuid())
  allergenId      String
  lotNo           String
  expirationDate  DateTime
  receivedDate    DateTime
  initialQuantity Int
  memo            String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  allergen        Allergen         @relation(fields: [allergenId], references: [id])
  shipmentItems   ShipmentItem[]
  stockMovements  StockMovement[]
  warehouseStocks WarehouseStock[]

  @@unique([allergenId, lotNo, expirationDate])
  @@index([lotNo])
  @@index([expirationDate])
}

model WarehouseStock {
  reagentLotId String
  warehouse    Warehouse
  quantity     Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  reagentLot   ReagentLot @relation(fields: [reagentLotId], references: [id], onDelete: Cascade)

  @@id([reagentLotId, warehouse])
  @@index([warehouse, quantity])
}

model Client {
  id                 String   @id @default(cuid())
  name               String
  region             String?
  managerName        String?
  deliveryDepartment String?
  memo               String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  orders             Order[]
}

model Order {
  id                    String      @id @default(cuid())
  orderNo               String      @unique
  clientId              String
  status                OrderStatus @default(RECEIVED)
  origin                OrderOrigin @default(MANUAL)
  shortageFromShipmentId String?    @unique
  memo                  String?
  createdBy             String
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  client                Client      @relation(fields: [clientId], references: [id])
  creator               User        @relation("OrderCreatedBy", fields: [createdBy], references: [id])
  items                 OrderItem[]
  shipments             Shipment[]
  image                 OrderImage?
  shortageFromShipment  Shipment?   @relation("ShipmentShortageReorder", fields: [shortageFromShipmentId], references: [id])

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model OrderImage {
  id          String   @id @default(cuid())
  orderId     String   @unique
  fileName    String
  contentType String
  byteSize    Int
  data        Bytes
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  allergenId String
  quantity   Int
  order      Order    @relation(fields: [orderId], references: [id])
  allergen   Allergen @relation(fields: [allergenId], references: [id])

  @@unique([orderId, allergenId])
  @@index([allergenId])
}

model Shipment {
  id               String                    @id @default(cuid())
  orderId          String
  status           ShipmentStatus            @default(SHIPPED)
  fulfillmentStatus ShipmentFulfillmentStatus @default(NORMAL)
  purpose          ShipmentPurpose           @default(ORDER)
  shippedBy        String
  shippedAt        DateTime                  @default(now())
  memo             String?
  order            Order                     @relation(fields: [orderId], references: [id])
  shipper          User                      @relation("ShipmentShippedBy", fields: [shippedBy], references: [id])
  items            ShipmentItem[]
  replacement      Replacement?              @relation("ReplacementShipment")
  shortageReorder  Order?                    @relation("ShipmentShortageReorder")

  @@index([orderId])
  @@index([shippedAt])
}

model ShipmentItem {
  id           String       @id @default(cuid())
  shipmentId   String
  reagentLotId String
  allergenId   String
  quantity     Int
  shipment     Shipment     @relation(fields: [shipmentId], references: [id])
  reagentLot   ReagentLot   @relation(fields: [reagentLotId], references: [id])
  replacement  Replacement? @relation("OriginalShipmentItem")

  @@index([shipmentId])
  @@index([reagentLotId])
}

model ReplacementPolicy {
  id                       String   @id
  detectionDays            Int
  minimumDeliveryShelfDays Int
  updatedAt                DateTime @updatedAt
}

model Replacement {
  id                     String             @id @default(cuid())
  replacementNo          String             @unique
  originalShipmentItemId String             @unique
  confirmedQuantity      Int
  status                 ReplacementStatus  @default(CONFIRMED)
  returnDisposition      ReturnDisposition?
  exclusionReason        String?
  replacementShipmentId  String?            @unique
  createdBy              String
  completedBy            String?
  createdAt              DateTime           @default(now())
  completedAt            DateTime?
  updatedAt              DateTime           @updatedAt
  originalShipmentItem   ShipmentItem       @relation("OriginalShipmentItem", fields: [originalShipmentItemId], references: [id], onDelete: Restrict)
  replacementShipment    Shipment?          @relation("ReplacementShipment", fields: [replacementShipmentId], references: [id], onDelete: Restrict)
  creator                User               @relation("ReplacementCreatedBy", fields: [createdBy], references: [id])
  completer              User?              @relation("ReplacementCompletedBy", fields: [completedBy], references: [id])

  @@index([status, createdAt])
  @@index([createdBy])
  @@index([completedBy])
}

model StockMovement {
  id                   String            @id @default(cuid())
  reagentLotId         String
  type                 StockMovementType
  quantity             Int
  warehouse            Warehouse         @default(FINISHED_GOODS)
  destinationWarehouse Warehouse?
  reason               String?
  refType              String?
  refId                String?
  createdBy            String
  createdAt            DateTime          @default(now())
  reagentLot           ReagentLot        @relation(fields: [reagentLotId], references: [id])
  creator              User              @relation(fields: [createdBy], references: [id])

  @@index([reagentLotId])
  @@index([createdBy])
  @@index([createdAt])
  @@index([warehouse, createdAt])
  @@index([destinationWarehouse, createdAt])
}
