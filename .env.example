# Supabase session pooler (:5432) is recommended for this project.
# Keep DATABASE_URL and DIRECT_URL on the same reachable PostgreSQL schema.
DATABASE_URL="postgresql://USER:PASSWORD@TRANSACTION_POOLER_HOST:6543/postgres?schema=public&pgbouncer=true&connection_limit=3&pool_timeout=30"
DIRECT_URL="postgresql://USER:PASSWORD@SESSION_POOLER_HOST:5432/postgres?schema=public"
TEST_DATABASE_URL="postgresql://TEST_USER:PASSWORD@TEST_SESSION_POOLER_HOST:5432/postgres?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
# Required when prisma:seed creates an administrator or rotates the legacy seed account.
# Use a unique temporary password of at least 12 characters; it must be changed after login.
SEED_ADMIN_PASSWORD=
# Must exactly match the host:port/database?schema target derived from DIRECT_URL.
# This prevents an approved seed command from silently following a wrong database URL.
SEED_DATABASE_TARGET=
# Development only. Never enable this in production.
ALLOW_SAMPLE_DATA="false"
AUTH_URL="http://localhost:3000"
APP_ENV="local"
