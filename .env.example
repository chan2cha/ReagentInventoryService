# Local development example. Replace every placeholder before running the app.
# Supabase runtime may use the transaction pooler (:6543); migrations and seed
# should use the direct connection or session pooler (:5432).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Use a unique random value of at least 32 characters outside local development.
AUTH_SECRET=CHANGE_TO_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AUTH_URL=http://localhost:3000
APP_ENV=development

# Sample fallback is disabled unless explicitly enabled in development.
ALLOW_SAMPLE_DATA=false

# Leave empty until an isolated PostgreSQL test database is prepared.
TEST_DATABASE_URL=

# Seed-only safeguards. Set these in the shell only for an approved non-production DB.
# SEED_ADMIN_PASSWORD=
# SEED_DATABASE_TARGET=HOST:5432/DATABASE?schema=public
