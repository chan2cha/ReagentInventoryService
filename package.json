{
  "name": "reagent-inventory-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:seed": "node prisma/seed.js",
    "prisma:rotate-legacy-admin": "node prisma/seed.js --rotate-legacy-admin"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "exceljs": "4.4.0",
    "lucide-react": "^1.24.0",
    "next": "latest",
    "pg": "^8.22.0",
    "react": "latest",
    "react-dom": "latest",
    "server-only": "^0.0.1",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "^8.20.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "prisma": "^7.9.0",
    "typescript": "latest",
    "vitest": "latest"
  },
  "overrides": {
    "exceljs": {
      "archiver": "8.0.0",
      "fast-csv": "5.0.7",
      "unzipper": "0.12.5",
      "uuid": "11.1.1"
    }
  }
}
